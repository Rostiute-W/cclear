{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口只被授予本应用的命令权限",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-candidate-locks",
    "allow-open-candidate-in-explorer",
    "allow-command-execute",
    "allow-env-state",
    "allow-plan-build",
    "allow-plan-items",
    "allow-plan-execute",
    "allow-plan-cancel",
    "allow-history-list",
    "allow-history-detail",
    "allow-recycle-bin-query",
    "allow-recycle-bin-empty",
    "allow-rules-catalog",
    "allow-rules-evaluate",
    "allow-volume-info",
    "allow-default-scan-roots",
    "allow-scan-start",
    "allow-scan-cancel",
    "allow-scan-summary",
    "allow-scan-children",
    "allow-scan-top-files",
    "allow-open-node-in-explorer",
    "allow-open-top-file-in-explorer"
  ]
}
