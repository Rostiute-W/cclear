{
  "id": "builtin",
  "name": "CClear 内置规则",
  "version": "2.0.0",
  "description": "系统垃圾、浏览器、常用应用及开发工具缓存",
  "rules": [
    {"id":"user-temp","name":"用户临时文件","description":"超过保留时间的临时文件","category":"system","defaultSelected":true,"deleteMode":"direct","minAgeHours":24,"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Temp"]}]}},
    {"id":"user-dumps","name":"应用崩溃转储","description":"用户应用产生的转储文件","category":"system","defaultSelected":true,"deleteMode":"direct","extensions":["dmp","mdmp"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["CrashDumps"]}]}},
    {"id":"user-wer","name":"应用错误报告","description":"已经生成的 Windows 错误报告","category":"system","defaultSelected":true,"deleteMode":"direct","target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Microsoft\\Windows\\WER\\ReportArchive","Microsoft\\Windows\\WER\\ReportQueue"]}]}},
    {"id":"thumbnail-cache","name":"缩略图和图标缓存","description":"资源管理器可重建的图片与图标缓存","category":"system","defaultSelected":true,"deleteMode":"direct","target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Microsoft\\Windows\\Explorer\\thumbcache_*.db","Microsoft\\Windows\\Explorer\\iconcache_*.db"]}]}},
    {"id":"shader-cache","name":"图形着色器缓存","description":"DirectX 和图形驱动可重建的缓存","category":"system","defaultSelected":true,"deleteMode":"direct","target":{"kind":"paths","paths":[{"root":"localAppData","rels":["D3DSCache","NVIDIA\\DXCache","NVIDIA\\GLCache","NVIDIA Corporation\\NV_Cache","AMD\\DxCache","AMD\\GLCache","AMD\\VkCache","Intel\\ShaderCache"]}]}},
    {"id":"recycle-bin","name":"C 盘回收站","description":"清空 C 盘的回收站","category":"system","defaultSelected":true,"deleteMode":"recycleBin","warning":"清空后无法从回收站恢复。","target":{"kind":"recycleBin"}},
    {"id":"windows-temp","name":"Windows 临时文件","description":"超过保留时间的系统临时文件","category":"system","defaultSelected":true,"admin":true,"deleteMode":"systemOp","target":{"kind":"systemOp","op":"windows-temp"}},
    {"id":"windows-logs","name":"Windows 系统日志","description":"超过七天的日志、跟踪和压缩日志","category":"system","defaultSelected":true,"admin":true,"deleteMode":"systemOp","target":{"kind":"systemOp","op":"windows-logs"}},
    {"id":"software-distribution","name":"Windows 更新下载缓存","description":"更新下载临时文件","category":"system","defaultSelected":true,"admin":true,"deleteMode":"systemOp","target":{"kind":"systemOp","op":"software-distribution"}},
    {"id":"delivery-optimization","name":"传递优化缓存","description":"传递优化服务的下载缓存","category":"system","defaultSelected":true,"admin":true,"deleteMode":"systemOp","target":{"kind":"systemOp","op":"delivery-optimization"}},
    {"id":"wer-system","name":"系统错误报告","description":"Windows 错误报告归档和队列","category":"system","defaultSelected":true,"admin":true,"deleteMode":"systemOp","target":{"kind":"systemOp","op":"wer-system"}},
    {"id":"windows-minidump","name":"系统崩溃转储","description":"系统崩溃转储与小型转储","category":"system","defaultSelected":true,"admin":true,"deleteMode":"systemOp","target":{"kind":"systemOp","op":"windows-minidump"}},
    {"id":"defender-history","name":"Defender 扫描历史","description":"过期扫描记录，不清理隔离区","category":"system","defaultSelected":true,"admin":true,"deleteMode":"systemOp","target":{"kind":"systemOp","op":"defender-history"}},
    {"id":"sys-reset","name":"系统重置残留","description":"Windows 系统重置的残余文件","category":"system","admin":true,"deleteMode":"systemOp","warning":"可能失去重置诊断或回退文件。","target":{"kind":"systemOp","op":"sys-reset"}},
    {"id":"windows-bt","name":"系统升级残留","description":"Windows 升级暂存文件","category":"system","admin":true,"deleteMode":"systemOp","warning":"可能影响正在等待完成的升级或回退。","target":{"kind":"systemOp","op":"windows-bt"}},
    {"id":"windows-old","name":"旧版 Windows 残留","description":"升级后仍在旧系统目录中的文件","category":"system","admin":true,"deleteMode":"systemOp","warning":"清理可能影响回退功能。旧用户目录保持保护。","target":{"kind":"systemOp","op":"windows-old"}},
    {"id":"edge","name":"Microsoft Edge 缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["msedge.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["Microsoft\\Edge\\User Data","Microsoft\\Edge Beta\\User Data","Microsoft\\Edge Dev\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache","DawnCache"]}},
    {"id":"chrome","name":"Google Chrome 缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["chrome.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["Google\\Chrome\\User Data","Google\\Chrome SxS\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache","DawnCache"]}},
    {"id":"firefox","name":"Firefox 缓存","description":"Firefox 各用户配置的网络缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["firefox.exe"],"target":{"kind":"firefoxProfiles","base":{"root":"localAppData","rels":["Mozilla\\Firefox\\Profiles"]},"rels":["cache2","startupCache"]}},
    {"id":"brave","name":"Brave 缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["brave.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["BraveSoftware\\Brave-Browser\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache"]}},
    {"id":"opera","name":"Opera 缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["opera.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["Opera Software\\Opera Stable","Opera Software\\Opera GX Stable"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache"]}},
    {"id":"vivaldi","name":"Vivaldi 缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["vivaldi.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["Vivaldi\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache"]}},
    {"id":"arc","name":"Arc 缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["Arc.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["Arc\\User Data","Packages\\TheBrowserCompany.Arc_*\\LocalCache\\Local\\Arc\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache"]}},
    {"id":"quark","name":"夸克浏览器缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["quark.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["Quark\\User Data","Quark\\QuarkBrowser\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache"]}},
    {"id":"browser360","name":"360 极速浏览器缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["360chrome.exe","360chromeX.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["360Chrome\\Chrome\\User Data","360ChromeX\\Chrome\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache"]}},
    {"id":"qq-browser","name":"QQ 浏览器缓存","description":"浏览器可重建的缓存","category":"browser","defaultSelected":true,"deleteMode":"direct","processes":["QQBrowser.exe"],"target":{"kind":"chromiumProfiles","base":{"root":"localAppData","rels":["Tencent\\QQBrowser\\User Data"]},"rels":["Cache","Code Cache","GPUCache","GrShaderCache","ShaderCache"]}},
    {"id":"wechat-logs","name":"微信日志","description":"微信应用诊断日志","category":"app","defaultSelected":true,"deleteMode":"direct","processes":["WeChat.exe","Weixin.exe"],"target":{"kind":"paths","paths":[{"root":"roamingAppData","rels":["Tencent\\WeChat\\log","Tencent\\Weixin\\log","Tencent\\xwechat\\log"]}]}},
    {"id":"wechat-cache","name":"微信临时缓存","description":"应用数据目录中的临时缓存","category":"app","deleteMode":"direct","warning":"部分内容可能需要重新加载。","processes":["WeChat.exe","Weixin.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Tencent\\WeChat\\Cache","Tencent\\WeChat\\Temp","Tencent\\Weixin\\Cache"]}]}},
    {"id":"qq","name":"QQ 缓存和日志","description":"QQ 与 NTQQ 应用缓存","category":"app","defaultSelected":true,"deleteMode":"direct","processes":["QQ.exe"],"target":{"kind":"paths","paths":[{"root":"roamingAppData","rels":["Tencent\\QQ\\log","Tencent\\QQ\\Cache","Tencent\\QQ\\nt_qq\\Cache","Tencent\\QQ\\nt_qq\\Code Cache","Tencent\\QQ\\nt_qq\\GPUCache"]}]}},
    {"id":"dingtalk-logs","name":"钉钉日志","description":"钉钉诊断日志","category":"app","defaultSelected":true,"deleteMode":"direct","processes":["DingTalk.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["DingTalk\\log"]},{"root":"roamingAppData","rels":["DingTalk\\log"]}]}},
    {"id":"dingtalk-cache","name":"钉钉临时缓存","description":"资源下载缓存和临时目录","category":"app","deleteMode":"direct","warning":"下次使用可能重新下载资源。","processes":["DingTalk.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["DingTalk\\Temp","DingTalk\\xcdn","DingTalk\\resource_cache"]}]}},
    {"id":"feishu","name":"飞书和 Lark 缓存","description":"客户端可重建的缓存","category":"app","defaultSelected":true,"deleteMode":"direct","processes":["Feishu.exe","Lark.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Feishu\\Cache","Feishu\\logs","Lark\\Cache","Lark\\logs","LarkShell\\Cache"]}]}},
    {"id":"wps","name":"WPS 日志和下载缓存","description":"应用诊断和更新暂存，不包含文档备份","category":"app","defaultSelected":true,"deleteMode":"direct","processes":["wps.exe","et.exe","wpp.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Kingsoft\\WPS Office\\log","Kingsoft\\WPS Office\\download","Kingsoft\\WPS Office\\update","Kingsoft\\office6\\log"]}]}},
    {"id":"gpu-installers","name":"显卡安装包残留","description":"NVIDIA 和 AMD 解包文件与下载缓存","category":"app","admin":true,"deleteMode":"systemOp","warning":"请在显卡驱动安装或更新结束后再清理。","target":{"kind":"systemOp","op":"nvidia-downloader"}},
    {"id":"steam","name":"Steam 客户端缓存","description":"客户端网页缓存和转储","category":"app","defaultSelected":true,"deleteMode":"direct","processes":["steam.exe","steamwebhelper.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Steam\\htmlcache\\Cache","Steam\\htmlcache\\Code Cache","Steam\\htmlcache\\GPUCache","Steam\\dumps"]}]}},
    {"id":"media","name":"创意和影音应用缓存","description":"Adobe、Spotify 与 VLC 可重新生成的缓存","category":"app","defaultSelected":true,"deleteMode":"direct","processes":["Adobe Premiere Pro.exe","Spotify.exe","vlc.exe"],"target":{"kind":"paths","paths":[{"root":"roamingAppData","rels":["Adobe\\Common\\Media Cache","Adobe\\Common\\Media Cache Files","vlc\\art\\artistalbum"]},{"root":"localAppData","rels":["Spotify\\Browser\\Cache"]}]}},
    {"id":"npm","name":"npm 下载缓存","description":"运行 npm 官方清理命令","category":"dev","defaultSelected":true,"deleteMode":"command","target":{"kind":"command","command":"npm"}},
    {"id":"pnpm","name":"pnpm 未使用的缓存","description":"清理不再被引用的包","category":"dev","defaultSelected":true,"deleteMode":"command","target":{"kind":"command","command":"pnpm"}},
    {"id":"pip","name":"pip 缓存","description":"清理 wheel 与 HTTP 下载缓存","category":"dev","defaultSelected":true,"deleteMode":"command","target":{"kind":"command","command":"pip"}},
    {"id":"uv-prune","name":"uv 未使用的缓存","description":"清理过期与未使用的缓存","category":"dev","defaultSelected":true,"deleteMode":"command","target":{"kind":"command","command":"uvPrune"}},
    {"id":"uv-clean","name":"uv 全量缓存","description":"清空 uv 缓存","category":"dev","deleteMode":"command","warning":"下次使用需要重新下载。","target":{"kind":"command","command":"uvClean"}},
    {"id":"conda","name":"Conda 下载和索引缓存","description":"清理下载归档、索引和日志","category":"dev","deleteMode":"command","warning":"下次使用需要重新下载。","target":{"kind":"command","command":"conda"}},
    {"id":"nuget-temp","name":"NuGet HTTP 和临时缓存","description":"清理 NuGet 网络下载缓存和临时文件","category":"dev","defaultSelected":true,"deleteMode":"command","target":{"kind":"command","command":"nugetHttpTemp"}},
    {"id":"nuget-packages","name":"NuGet 全局包缓存","description":"清空全局包缓存","category":"dev","deleteMode":"command","warning":"下次恢复包需要重新下载。","target":{"kind":"command","command":"nugetGlobalPackages"}},
    {"id":"yarn-bun","name":"Yarn 和 Bun 包缓存","description":"可重新下载的包缓存","category":"dev","defaultSelected":true,"deleteMode":"direct","processes":["node.exe","bun.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["Yarn\\Cache"]},{"root":"profile","rels":[".yarn\\berry\\cache",".bun\\install\\cache"]}]}},
    {"id":"cargo","name":"Cargo 下载缓存","description":"已下载的软件包归档和 Git 仓库缓存","category":"dev","defaultSelected":true,"deleteMode":"direct","processes":["cargo.exe"],"target":{"kind":"paths","paths":[{"root":"profile","rels":[".cargo\\registry\\cache",".cargo\\git\\db"]}]}},
    {"id":"go","name":"Go 编译缓存","description":"可重新生成的编译产物缓存","category":"dev","defaultSelected":true,"deleteMode":"direct","processes":["go.exe"],"target":{"kind":"paths","paths":[{"root":"localAppData","rels":["go-build"]}]}},
    {"id":"gradle","name":"Gradle 缓存","description":"Gradle 构建和依赖缓存","category":"dev","deleteMode":"direct","warning":"下次构建可能需要重新下载依赖。","target":{"kind":"paths","paths":[{"root":"profile","rels":[".gradle\\caches"]}]}},
    {"id":"browser-automation","name":"自动化工具的浏览器缓存","description":"Playwright 和 Puppeteer 下载的浏览器副本","category":"dev","deleteMode":"direct","warning":"自动化测试可能需要重新下载浏览器。","target":{"kind":"paths","paths":[{"root":"localAppData","rels":["ms-playwright"]},{"root":"profile","rels":[".cache\\puppeteer"]}]}}
  ]
}
